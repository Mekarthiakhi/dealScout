# DealScout Backend Configuration

# ============================================
# SERVER CONFIG
# ============================================
PORT=5000
NODE_ENV=development

# ============================================
# CORS CONFIGURATION
# ============================================
# Comma-separated list of allowed origins
# For development: *
# For production: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGIN=*

# ============================================
# API KEYS & EXTERNAL SERVICES
# ============================================
# SerpAPI Key for Google Shopping results
# Get from: https://serpapi.com
SERPAPI_KEY=your_serpapi_key_here

# Google Custom Search API Key
# Get from: https://console.cloud.google.com
GOOGLE_API_KEY=your_google_api_key_here

# Google Custom Search Engine ID
# Get from: https://cse.google.com
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here

# ============================================
# SECURITY
# ============================================
# Admin key for cache management and stats
# Change this to a strong random value
ADMIN_KEY=your_secure_admin_key_here

# JWT Secret (for future authentication)
JWT_SECRET=your_jwt_secret_here

# ============================================
# LOGGING
# ============================================
# Log level: error, warn, info, debug
LOG_LEVEL=info

# ============================================
# DATABASE (Future)
# ============================================
# MONGODB_URI=mongodb://localhost:27017/dealscout
# DB_NAME=dealscout

# ============================================
# REDIS CACHE (Future)
# ============================================
# REDIS_URL=redis://localhost:6379

# ============================================
# EMAIL (Future)
# ============================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SUPPORT_EMAIL=support@dealscout.com
